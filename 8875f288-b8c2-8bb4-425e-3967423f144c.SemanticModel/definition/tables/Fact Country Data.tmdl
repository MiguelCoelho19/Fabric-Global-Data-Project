			)
			```
		formatString: 0
		lineageTag: 76e2fd90-6414-4185-a05a-12d1b45f8021

		changedProperty = Name

	measure MaxMinSlums = ```
			
			VAR CountryTable = 
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('Dimention Countries'[Country_Name], 'Dimention Countries'[Country_Code]),
			            "@SumAB", CALCULATE(SUM('Fact Country Data'[Population living in slums]) + SUM('Fact Country Data'[Population that are Roofless])),
			            "@ValC", CALCULATE(SUM('Fact Country Data'[Population using safely managed sanitation services])),
			            "@HasBlank", 
			                ISBLANK(CALCULATE(SUM('Fact Country Data'[Population living in slums]))) || 
			                ISBLANK(CALCULATE(SUM('Fact Country Data'[Population that are Roofless]))) || 
			                ISBLANK(CALCULATE(SUM('Fact Country Data'[Population using safely managed sanitation services])))
			        ),
			        [@HasBlank] = FALSE()
			    )
			
			-- Rank all valid countries: Highest Priority 1, then 2, then 3
			VAR RankedTable = 
			    ADDCOLUMNS(
			        CountryTable,
			        "@RankAsc", 
			            RANKX(
			                CountryTable, 
			                [@SumAB] + ([@ValC] / 1000000), , ASC, Dense
			            ),
			        "@RankDesc",
			            RANKX(
			                CountryTable, 
			                [@SumAB] + ([@ValC] / 1000000), , DESC, Dense
			            )
			    )
			
			-- Identify the absolute Top and Bottom IDs based on the tie-breakers
			-- We use MINX/MAXX on Country_Code to break the final string tie
			VAR TopRank = MINX(FILTER(RankedTable, [@RankDesc] = 1), 'Dimention Countries'[Country_Code])
			VAR BottomRank = MINX(FILTER(RankedTable, [@RankAsc] = 1), 'Dimention Countries'[Country_Code])
			
			VAR CurrentID = SELECTEDVALUE('Dimention Countries'[Country_Code])
			
			RETURN
			IF(CurrentID = TopRank || CurrentID = BottomRank, 1, 0)
			```
		formatString: 0
		lineageTag: 16b84bb3-793d-4801-9869-81c546ef3b51

		changedProperty = Name

		changedProperty = FormatString

