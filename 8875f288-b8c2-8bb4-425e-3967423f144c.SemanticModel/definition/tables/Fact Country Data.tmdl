			VAR inflation = AVERAGE('Fact Country Data'[Food price inflation])
			VAR insecurity = AVERAGE('Fact Country Data'[Population with food insecurity])
			VAR poverty = AVERAGE('Fact Country Data'[Population in poverty])
			RETURN
			IF(
			    NOT(ISBLANK(inflation)) &&
			    NOT(ISBLANK(insecurity)) &&
			    NOT(ISBLANK(poverty)), 
