	measure FilteredA3 = ```
			
			VAR Slums = AVERAGE('Fact Country Data'[Population living in slums])
			VAR Illiterate = AVERAGE('Fact Country Data'[Illiterate Population])
			RETURN
			IF(
			    NOT(ISBLANK(Slums)) &&
			    NOT(ISBLANK(Illiterate)), 
			    1, 
			    0
			)
			```
		formatString: 0
		lineageTag: 4cd7632e-20e1-4885-a318-2190e4f788e9

